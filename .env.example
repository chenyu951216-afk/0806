MAX_UNIVERSE=160
DEEP_SCAN_LIMIT=70
ORDERBOOK_FINALISTS=20
MAX_SIGNALS=70
COINGLASS_MARKET_PAGES=5
COINGLASS_PER_PAGE=100

MIN_SPOT_QUOTE_VOLUME_USDT=500000
MIN_FUTURES_QUOTE_VOLUME_USDT=500000
MIN_MARKET_CAP_USD=5000000
MAX_MARKET_CAP_USD=750000000
MAX_SPREAD_PCT=0.35
MAX_24H_PUMP_PCT=20
MAX_4H_PUMP_PCT=10
MIN_SETUP_SCORE=64
FORMAL_SIGNAL_SCORE=82
ALERT_SCORE=84

MIN_STOP_PCT=2
MAX_STOP_PCT=18
MAX_EXPECTED_MOVE_PCT=900
PLAN_TTL_CANDLES=48
TEN_X_MIN_STOP_ATR=2.2
TEN_X_STOP_BUFFER_ATR=0.35
PLAN_PRESERVE_TRIGGER_ATR=0.55
PLAN_PRESERVE_ZONE_OVERLAP=0.35

# LONG真人多因子門檻：較v4.4放寬，但仍保留結構/流動性硬風控
LIVE_EARLY_MIN_QUALITY=68
LIVE_RETEST_MIN_QUALITY=70
LIVE_EARLY_MIN_TEN_X_SCORE=68
LIVE_RETEST_MIN_TEN_X_SCORE=66
LIVE_HARD_MAX_SPREAD_PCT=0.85
LIVE_HARD_MAX_COLLAPSE_RATE=0.35

# BTC通常只調整風險；快速shock才硬暫停新LONG
BTC_HARD_SHOCK_15M_MIN_PCT=1.50
BTC_HARD_SHOCK_ATR_MULT=1.80
BTC_HARD_SHOCK_4H_PCT=-5.50
BTC_BREADTH_CRASH_PCT=18

# 證據分級真人風險
ENABLE_BOOTSTRAP_SYSTEM_ORDERS=true
BOOTSTRAP_MIN_EXECUTION_QUALITY=76
BOOTSTRAP_MAX_RISK_PCT=0.20
ENABLE_PROBATION_SYSTEM_ORDERS=true
MIN_PROBATION_TRADES_PER_MODE=4
PROBATION_MIN_PROFIT_FACTOR=1.00
PROBATION_MIN_EXPECTANCY_R=0.00
PROBATION_MAX_DRAWDOWN_R=4.5
PROBATION_MAX_RISK_PCT=0.50
MIN_VERIFIED_TRADES_PER_MODE=10
VERIFIED_MIN_PROFIT_FACTOR=1.10
VERIFIED_MIN_EXPECTANCY_R=0.05
VERIFIED_MAX_DRAWDOWN_R=6
VERIFIED_MAX_RISK_PCT=1.25

DEFAULT_NOTIONAL_USDT=100
DEFAULT_ACCOUNT_BALANCE_USDT=1000
RISK_PER_TRADE_PCT=2
MAX_USER_RISK_PER_TRADE_PCT=5
MAX_TOTAL_OPEN_RISK_PCT=8
MAX_TOTAL_NOTIONAL_PCT=100
MAX_PAIR_CORRELATION=0.72
MAX_CORRELATED_OPEN_POSITIONS=0
CORRELATION_LOOKBACK_CANDLES=96
INTRABAR_POLICY=conservative
ACTIONABLE_ALLOW_PENDING_LIMITS=true

# FORMAL forward validation：絕對門檻＋本輪相對強勢Top cohort
FORMAL_VALIDATION_EARLY_MIN_TEN_X_SCORE=58
FORMAL_VALIDATION_EARLY_MIN_EXECUTION_SCORE=50
FORMAL_VALIDATION_RETEST_MIN_SCORE=56
FORMAL_VALIDATION_RETEST_MIN_TEN_X_SCORE=56
FORMAL_VALIDATION_MAX_SPREAD_PCT=0.85
FORMAL_VALIDATION_MIN_ACCUMULATION_RATIO=0.85
FORMAL_VALIDATION_MIN_VOLUME_CONSISTENCY=0.12
FORMAL_VALIDATION_RELATIVE_TOP_PCT=30
FORMAL_VALIDATION_RELATIVE_SCORE_FLOOR=45

# SHORT崩盤前兆引擎
ENABLE_SHORT_ENGINE=true
SHORT_WATCH_SCORE=58
SHORT_EARLY_SCORE=62
SHORT_BREAKDOWN_SCORE=66
LIVE_SHORT_EARLY_MIN_QUALITY=68
LIVE_SHORT_RETEST_MIN_QUALITY=70
