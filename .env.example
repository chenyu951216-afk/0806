PORT=8080
DATA_DIR=/data
TZ_OFFSET_HOURS=8
AUTO_SCAN=true
DEMO_MODE=false

GATE_BASE_URL=https://api.gateio.ws/api/v4
GATE_WS_URL=wss://api.gateio.ws/ws/v4/
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_API_KEY=
COINGLASS_EXCHANGE=Gate
DISCORD_WEBHOOK_URL=

SCAN_INTERVAL_SECONDS=300
LIVE_PRICE_INTERVAL_SECONDS=5
TRACK_INTERVAL_SECONDS=20
PAPER_TRACK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=15
HTTP_CONCURRENCY=8
MAX_TRACKING_CANDLE_PAGES=6

MAX_UNIVERSE=160
DEEP_SCAN_LIMIT=70
ORDERBOOK_FINALISTS=20
MAX_SIGNALS=70
COINGLASS_MARKET_PAGES=5
COINGLASS_PER_PAGE=100

MIN_SPOT_QUOTE_VOLUME_USDT=500000
MIN_FUTURES_QUOTE_VOLUME_USDT=500000
MIN_MARKET_CAP_USD=5000000
MAX_MARKET_CAP_USD=750000000
MAX_SPREAD_PCT=0.35
MAX_24H_PUMP_PCT=20
MAX_4H_PUMP_PCT=10
MIN_SETUP_SCORE=64
FORMAL_SIGNAL_SCORE=82
ALERT_SCORE=84

MIN_STOP_PCT=2
MAX_STOP_PCT=18
MAX_EXPECTED_MOVE_PCT=900
PLAN_TTL_CANDLES=48
TEN_X_MIN_STOP_ATR=2.2
TEN_X_STOP_BUFFER_ATR=0.35
PLAN_PRESERVE_TRIGGER_ATR=0.55
PLAN_PRESERVE_ZONE_OVERLAP=0.35

DEFAULT_NOTIONAL_USDT=100
DEFAULT_ACCOUNT_BALANCE_USDT=1000
RISK_PER_TRADE_PCT=2
MAX_USER_RISK_PER_TRADE_PCT=5
MAX_TOTAL_OPEN_RISK_PCT=8
MAX_TOTAL_NOTIONAL_PCT=100
MAX_PAIR_CORRELATION=0.72
MAX_CORRELATED_OPEN_POSITIONS=0
CORRELATION_LOOKBACK_CANDLES=96
INTRABAR_POLICY=conservative
ACTIONABLE_ALLOW_PENDING_LIMITS=true

# v4.3 formal/core validation cohort. These collect evidence; they do NOT lower
# the stricter live execution thresholds used for real-money recommendations.
FORMAL_VALIDATION_EARLY_MIN_TEN_X_SCORE=70
FORMAL_VALIDATION_EARLY_MIN_EXECUTION_SCORE=62
FORMAL_VALIDATION_RETEST_MIN_SCORE=68
FORMAL_VALIDATION_RETEST_MIN_TEN_X_SCORE=68
FORMAL_VALIDATION_MAX_SPREAD_PCT=0.75
FORMAL_VALIDATION_MIN_ACCUMULATION_RATIO=0.95
FORMAL_VALIDATION_MIN_VOLUME_CONSISTENCY=0.16

# Progressive unlock: 5 good closed samples can enter low-risk probation.
ENABLE_PROBATION_SYSTEM_ORDERS=true
MIN_PROBATION_TRADES_PER_MODE=5
PROBATION_MIN_PROFIT_FACTOR=1.05
PROBATION_MIN_EXPECTANCY_R=0.00
PROBATION_MAX_DRAWDOWN_R=5
PROBATION_MAX_RISK_PCT=0.50

# Research-only pool. It never unlocks a real-money trade directly.
ENABLE_EXPLORATION_POOL=true
EXPLORATION_CORE_EARLY_MIN_TEN_X_SCORE=60
EXPLORATION_CORE_EARLY_MIN_EXECUTION_SCORE=52
EXPLORATION_CORE_RETEST_MIN_SCORE=60
EXPLORATION_CORE_RETEST_MIN_TEN_X_SCORE=60
EXPLORATION_MAX_SPREAD_PCT=0.60
EXPLORATION_MAX_NEW_ORDERS_PER_SCAN=20
EXPLORATION_MAX_ACTIVE_ORDERS=120

# Legacy v4.2 exploration knobs kept for compatibility; v4.3 core thresholds above
# are the effective broad research score gates.
EXPLORATION_EARLY_MIN_TEN_X_SCORE=74
EXPLORATION_EARLY_MIN_EXECUTION_SCORE=68
EXPLORATION_RETEST_MIN_SCORE=76
EXPLORATION_RETEST_MIN_TEN_X_SCORE=76
EXPLORATION_MAX_SOFT_FAILURES=4
EXPLORATION_MIN_ACCUMULATION_RATIO=1.05
EXPLORATION_MIN_VOLUME_CONSISTENCY=0.24

ENABLE_TEN_X_EARLY_ENTRY=true
TEN_X_WATCH_SCORE=68
TEN_X_EARLY_SCORE=80
TEN_X_CONFIRMED_SCORE=84
TEN_X_EARLY_TRANCHE_PCT=35
TEN_X_RUNNER_PCT=45
TEN_X_MIN_MARKET_CAP_USD=5000000
TEN_X_IDEAL_MARKET_CAP_USD=250000000
TEN_X_MAX_MARKET_CAP_USD=750000000
TEN_X_MAX_7D_PUMP_PCT=70
TEN_X_MAX_4H_PUMP_PCT=10
TEN_X_MIN_ACCUMULATION_RATIO=1.15
TEN_X_MIN_VOLUME_CONSISTENCY=0.33
TEN_X_EARLY_REPLAY_SAMPLES=2
TEN_X_EARLY_REPLAY_EXPECTANCY_R=0

ENABLE_EARLY_SWEEP_ENTRY=false
MICROSTRUCTURE_TOP_SYMBOLS=20
MICROSTRUCTURE_WINDOW_SECONDS=900
MICROSTRUCTURE_MIN_SECONDS=180
MICROSTRUCTURE_MIN_TRADES=40
MICROSTRUCTURE_MIN_BOOK_SAMPLES=20
MIN_TAKER_BUY_RATIO=0.55
MIN_BOOK_PERSISTENCE=0.58
MAX_BID_WALL_COLLAPSE_RATE=0.15

PAPER_VALIDATION_REQUIRED=true
MIN_PAPER_TRADES=20
MIN_PAPER_TRADES_PER_MODE=8
MIN_PAPER_PROFIT_FACTOR=1.20
MIN_PAPER_EXPECTANCY_R=0.10
MAX_PAPER_DRAWDOWN_R=8
MAX_NEW_PAPER_ORDERS_PER_SCAN=12
PAPER_MAX_ACTIVE_ORDERS=80
PAPER_MAX_HOLD_DAYS=21
MIN_LOCAL_REPLAY_SAMPLES=3
MIN_LOCAL_REPLAY_EXPECTANCY_R=0

EXCLUDED_BASES=BTC,ETH,BNB,SOL,XRP,DOGE,ADA,TRX,BCH,LTC,TON,DOT,USDC,USDE,DAI,FDUSD,TUSD,USDD,EUR,USD1,PAXG,XAUT,GT,WBTC,WETH,STETH
LOG_LEVEL=INFO
